#!/usr/bin/env bash
set -euo pipefail
# git-native pre-commit hook. Variant C; no framework dependency.
# core.hooksPath = .git-hooks (set by `git config core.hooksPath .git-hooks`).

bash "$(dirname "$0")/check-naming.sh"

# Rust gates. Run only when a root manifest exists (t0 worker lands it);
# before that, product checks are unavailable and reported by `just check`.
if [ -f Cargo.toml ]; then
  cargo fmt --check
  cargo clippy --all-targets -- -D warnings -D clippy::cognitive_complexity -D clippy::too_many_lines
  cargo machete
  cargo dupes check -p src --exclude-tests --max-exact-percent 3 --max-near-percent 3
fi
